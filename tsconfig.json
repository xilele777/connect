{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["@types/node", "@cloudflare/vitest-pool-workers/types", "vitest/globals"]
  },
  "include": ["src", "test", "worker-configuration.d.ts", "vitest.config.ts"]
}
